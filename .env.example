# =============================================================================
# RevivePay — Environment Configuration
# =============================================================================
# Copy this file to backend/.env and fill in your values:
#   cp .env.example backend/.env
#
# The FastAPI backend loads environment variables from backend/.env
# (relative to the backend working directory via pydantic-settings).
#
# NEVER commit backend/.env to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://revivepay:revivepay_dev@localhost:5433/revivepay
DATABASE_URL_SYNC=postgresql://revivepay:revivepay_dev@localhost:5433/revivepay

# --- Razorpay (Test Mode) ---
# Optional: enables real Razorpay Test Mode payment links.
# Without these, payment links are simulated (Developer Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required: HMAC secret for webhook signature verification.
# Any string works for Demo Mode (must match between demo sender and receiver).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- AI / LLM ---
# Set AI_PROVIDER to "gemini" or "openai" to select the AI backend.
# Without a valid API key (or in APP_MODE=developer), the system
# uses a deterministic fallback — no external AI calls are made.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_MODE=developer
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
